.page-shell {
  min-height: 100vh;
  padding: 14rpx 12rpx calc(22rpx + env(safe-area-inset-bottom));
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.32) 1px, transparent 1px),
    linear-gradient(90deg, rgba(90, 89, 81, 0.05) 1px, transparent 1px);
  background-size: 28rpx 28rpx, 28rpx 28rpx;
}

.terminal-shell {
  position: relative;
  box-sizing: border-box;
  max-width: 980rpx;
  margin: 0 auto;
  padding: 16rpx;
  border-radius: 36rpx;
  border: 2rpx solid #fbfaf5;
  background:
    linear-gradient(125deg, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0) 34%),
    linear-gradient(145deg, #f8f7f1, #e9e7df 48%, #cbc9bf);
  box-shadow:
    0 28rpx 54rpx rgba(31, 35, 34, 0.22),
    inset 0 3rpx 0 rgba(255, 255, 255, 0.86),
    inset 0 -18rpx 28rpx rgba(120, 118, 108, 0.28);
  overflow: hidden;
}

.terminal-shell::before {
  content: "";
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  top: 12rpx;
  bottom: 12rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(121, 118, 108, 0.42);
  pointer-events: none;
}

.terminal-shell::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  opacity: 0.14;
  background-image: radial-gradient(circle, rgba(70, 67, 59, 0.42) 0 1rpx, transparent 1.5rpx);
  background-size: 11rpx 11rpx;
  pointer-events: none;
}

.screw {
  position: absolute;
  z-index: 3;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(78, 77, 70, 0.2)),
    radial-gradient(circle at 38% 35%, #f7f5ea 0 22%, #aaa89d 58%, #6f7068 100%);
  box-shadow:
    inset 0 3rpx 5rpx rgba(255, 255, 255, 0.78),
    inset 0 -4rpx 6rpx rgba(34, 34, 30, 0.26);
}

.screw::after {
  content: "";
  position: absolute;
  left: 6rpx;
  right: 6rpx;
  top: 13rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: rgba(54, 55, 50, 0.42);
  transform: rotate(-22deg);
}

.screw-a { left: 14rpx; top: 14rpx; }
.screw-b { right: 14rpx; top: 14rpx; }
.screw-c { left: 14rpx; bottom: 14rpx; }
.screw-d { right: 14rpx; bottom: 14rpx; }

.monitor-panel {
  position: relative;
  z-index: 2;
  padding: 12rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(103, 101, 92, 0.5);
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0.5), transparent 42%, rgba(112, 109, 99, 0.08)),
    linear-gradient(145deg, #e3e1d8, #c3c1b7);
  box-shadow:
    inset 0 3rpx 0 rgba(255, 255, 255, 0.76),
    inset 0 -12rpx 22rpx rgba(91, 88, 78, 0.18);
}

.tv-console {
  display: grid;
  grid-template-columns: 136rpx minmax(0, 1fr);
  gap: 10rpx;
  align-items: stretch;
}

.side-controls {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  overflow: hidden;
  padding: 8rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(77, 76, 68, 0.42);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.36), rgba(255, 255, 255, 0.04)),
    #d6d4cb;
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.72),
    inset 0 -4rpx 8rpx rgba(93, 91, 82, 0.16);
}

.control-cluster {
  display: grid;
  gap: 6rpx;
  min-width: 0;
}

.cluster-label {
  color: #656b66;
  font-size: 17rpx;
  line-height: 1;
}

.screen-stack {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  min-width: 0;
}

.load-button,
.control-key,
.tone-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  max-width: 100%;
  margin: 0;
  padding: 0;
  color: #1d2529;
  font-family: "Courier New", Consolas, monospace;
  font-weight: 700;
  line-height: 1.35;
  white-space: nowrap;
  overflow: visible;
  border-radius: 12rpx;
  border: 1rpx solid rgba(54, 54, 48, 0.62);
  background: linear-gradient(180deg, #f1f0e8, #bdbbb0);
  box-shadow:
    inset 0 3rpx 0 rgba(255, 255, 255, 0.86),
    inset 0 -5rpx 0 rgba(87, 86, 78, 0.18),
    0 5rpx 0 #8a887f,
    0 8rpx 12rpx rgba(49, 48, 43, 0.12);
}

.load-button text,
.control-key text,
.tone-chip text {
  display: block;
  min-width: 0;
  max-width: 100%;
  overflow: visible;
  white-space: nowrap;
  line-height: 1.35;
}

.pressed {
  transform: translateY(3rpx);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.78),
    inset 0 -2rpx 0 rgba(87, 86, 78, 0.18),
    0 2rpx 0 #8a887f;
}

.load-button {
  width: 100%;
  height: 58rpx;
  font-size: 18rpx;
}

.load-button.primary {
  background: linear-gradient(180deg, #fff6e7, #d8a74f 52%, #aa7b2c);
}

.control-key {
  width: 100%;
  height: 63rpx;
  font-size: 22rpx;
}

.control-key.compact {
  height: 57rpx;
  font-size: 19rpx;
}

.control-key.active,
.tone-chip.active {
  color: #f7fff5;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.13), rgba(255, 255, 255, 0)),
    linear-gradient(180deg, #39515a, #172226);
  box-shadow:
    inset 0 3rpx 4rpx rgba(255, 255, 255, 0.16),
    inset 0 -3rpx 9rpx rgba(0, 0, 0, 0.34),
    0 3rpx 0 #717068,
    0 0 14rpx rgba(70, 126, 158, 0.26);
}

.tone-chip {
  width: 100%;
  height: 57rpx;
  justify-content: flex-start;
  gap: 6rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
}

.swatch {
  flex: 0 0 auto;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(25, 26, 23, 0.45);
  box-shadow: inset 0 2rpx 3rpx rgba(255, 255, 255, 0.4), 0 0 8rpx currentColor;
}

.swatch.green {
  color: #7cff8a;
  background: #7cff8a;
}

.swatch.amber {
  color: #ffc35a;
  background: #ffc35a;
}

.swatch.paper {
  color: #d7f0e7;
  background: #d7f0e7;
}

.effect-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 10rpx;
}

.metal-toggle {
  display: grid;
  grid-template-columns: auto 1fr;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  padding: 8rpx 10rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(96, 94, 86, 0.34);
  background: rgba(255, 255, 255, 0.18);
  color: #303736;
  font-size: 20rpx;
}

.toggle-body {
  position: relative;
  width: 42rpx;
  height: 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(54, 54, 48, 0.58);
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.22), rgba(255, 255, 255, 0.13)), #9d9d94;
  box-shadow: inset 0 3rpx 8rpx rgba(0, 0, 0, 0.28), 0 1rpx 0 rgba(255, 255, 255, 0.5);
}

.toggle-knob {
  position: absolute;
  left: 4rpx;
  top: 3rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #f5f4ed, #929087);
  box-shadow: 0 3rpx 5rpx rgba(0, 0, 0, 0.28), inset 0 1rpx 1rpx rgba(255, 255, 255, 0.88);
}

.toggle-body.checked {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.22), rgba(0, 0, 0, 0.18)), #557a62;
}

.toggle-body.checked .toggle-knob {
  left: 20rpx;
  background: linear-gradient(145deg, #edffe8, #7ac96e);
}

.save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  margin-top: 12rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(76, 74, 66, 0.68);
  color: #15201c;
  font-family: "Courier New", monospace;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.66), rgba(255, 255, 255, 0) 38%),
    linear-gradient(180deg, #bce1c3 0%, #84aa8d 48%, #5f806a 100%);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.82),
    inset 0 -6rpx 0 rgba(57, 68, 58, 0.28),
    0 6rpx 10rpx rgba(52, 51, 44, 0.26);
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.45);
}

.save-button.saving {
  color: #d3ead6;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.16), transparent 38%),
    linear-gradient(180deg, #314a44, #1d2b27);
  box-shadow:
    inset 0 3rpx 8rpx rgba(0, 0, 0, 0.4),
    0 2rpx 4rpx rgba(52, 51, 44, 0.18);
  text-shadow: 0 0 8rpx rgba(124, 255, 138, 0.32);
}

.crt-frame {
  box-sizing: border-box;
  width: 100%;
  padding: 16rpx 14rpx 12rpx;
  border-radius: 36rpx;
  border: 1rpx solid rgba(51, 53, 49, 0.68);
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.34), transparent 28%),
    linear-gradient(180deg, #414640, #1e2422 58%, #111615);
  box-shadow:
    inset 0 4rpx 2rpx rgba(255, 255, 255, 0.14),
    inset 0 -9rpx 18rpx rgba(0, 0, 0, 0.56),
    0 12rpx 24rpx rgba(62, 61, 55, 0.13);
}

.glass-bezel {
  position: relative;
  height: 760rpx;
  overflow: hidden;
  border-radius: 34rpx;
  border: 8rpx solid #131817;
  background: #041009;
  box-shadow:
    inset 0 0 34rpx rgba(0, 0, 0, 0.96),
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.06);
}

.screen-canvas {
  position: relative;
  z-index: 3;
  display: block;
  width: 100%;
  height: 100%;
  background: #031008;
}

.processed-video {
  position: absolute;
  z-index: 3;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: #000;
}

.screen-reflection,
.scanline-layer,
.phosphor-mask,
.screen-vignette {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
}

.screen-reflection {
  z-index: 5;
  background:
    linear-gradient(118deg, rgba(255, 255, 255, 0.16) 0 10%, transparent 10.5% 34%, rgba(255, 255, 255, 0.08) 35%, transparent 48%),
    radial-gradient(circle at 18% 10%, rgba(255, 255, 255, 0.08), transparent 240rpx);
}

.scanline-layer {
  z-index: 4;
  opacity: 0.38;
  background:
    repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.14) 0 1rpx, transparent 1rpx 5rpx),
    repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.06) 0 1rpx, transparent 1rpx 8rpx);
}

.phosphor-mask {
  z-index: 3;
  opacity: 0.32;
  background-image: radial-gradient(circle, rgba(255, 255, 255, 0.13) 0 1rpx, transparent 1.6rpx);
  background-size: 7rpx 7rpx;
}

.screen-vignette {
  z-index: 6;
  box-shadow:
    inset 0 0 78rpx rgba(0, 0, 0, 0.95),
    inset 0 0 24rpx rgba(0, 0, 0, 0.8);
  background: radial-gradient(ellipse at center, transparent 48%, rgba(0, 0, 0, 0.36) 100%);
}

.crt-frame.glow-on.tone-green .glass-bezel {
  box-shadow:
    inset 0 0 34rpx rgba(0, 0, 0, 0.96),
    inset 0 0 30rpx rgba(124, 255, 138, 0.12),
    0 0 28rpx rgba(124, 255, 138, 0.16);
}

.crt-frame.glow-on.tone-amber .glass-bezel {
  box-shadow:
    inset 0 0 34rpx rgba(0, 0, 0, 0.96),
    inset 0 0 30rpx rgba(255, 195, 90, 0.12),
    0 0 28rpx rgba(255, 195, 90, 0.14);
}

.crt-frame.glow-on.tone-paper .glass-bezel {
  box-shadow:
    inset 0 0 34rpx rgba(0, 0, 0, 0.96),
    inset 0 0 30rpx rgba(215, 240, 231, 0.1),
    0 0 28rpx rgba(70, 126, 158, 0.12);
}

.monitor-label {
  min-height: 30rpx;
  padding: 10rpx 6rpx 0;
  color: #ccd0c3;
  font-size: 17rpx;
  text-align: right;
}

.scan-panel {
  margin-top: 12rpx;
  padding: 14rpx 16rpx 12rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(96, 94, 86, 0.42);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.42), rgba(255, 255, 255, 0.04)),
    #d8d6cd;
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.72),
    inset 0 -4rpx 8rpx rgba(93, 91, 82, 0.16);
}

.scan-top {
  display: block;
}

.scan-title {
  display: flex;
  min-width: 0;
  flex-direction: column;
  justify-content: space-between;
  color: #454b4a;
  font-size: 22rpx;
}

.scan-title text:last-child {
  max-width: 100%;
  margin-top: 3rpx;
  color: #73776f;
  font-size: 18rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.load-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 7rpx;
  min-width: 0;
}

.slider-block {
  padding-top: 6rpx;
}

.control-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #333a39;
  font-size: 23rpx;
}

.readout {
  min-width: 78rpx;
  padding: 7rpx 9rpx;
  border-radius: 8rpx;
  color: #8dff87;
  text-align: right;
  background: linear-gradient(180deg, rgba(20, 30, 24, 0.84), rgba(7, 10, 8, 0.96));
  border: 1rpx solid #343d34;
  box-shadow: inset 0 3rpx 6rpx rgba(0, 0, 0, 0.5), 0 1rpx 0 rgba(255, 255, 255, 0.34);
  text-shadow: 0 0 7rpx rgba(124, 255, 138, 0.58);
}

slider {
  margin: 0;
}

.sample-canvas {
  position: fixed;
  left: -1000px;
  top: -1000px;
  width: 8px;
  height: 8px;
  opacity: 0;
  pointer-events: none;
}

@media (max-width: 360px) {
  .tv-console {
    grid-template-columns: 124rpx minmax(0, 1fr);
    gap: 8rpx;
  }

  .glass-bezel {
    height: 700rpx;
  }

  .control-key {
    height: 56rpx;
    font-size: 20rpx;
  }

  .tone-chip {
    height: 50rpx;
    font-size: 18rpx;
  }

  .load-button {
    height: 52rpx;
    font-size: 17rpx;
  }
}
